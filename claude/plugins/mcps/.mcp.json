{
  "mcpServers": {
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "linear_personal": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp?workspace=zois"
    },
    "cloudflare": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "checkly": {
      "type": "http",
      "url": "https://api.checklyhq.com/mcp"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      }
    },
    "grafana_cloud": {
      "command": "uvx",
      "args": [
        "mcp-grafana==2.2.0"
      ],
      "env": {
        "GRAFANA_URL": "${GRAFANA_CLOUD_URL}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_CLOUD_SERVICE_ACCOUNT_TOKEN}"
      }
    },
    "grafana_k8s": {
      "command": "uvx",
      "args": [
        "mcp-grafana==2.2.0"
      ],
      "env": {
        "GRAFANA_URL": "${GRAFANA_K8S_URL}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_K8S_SERVICE_ACCOUNT_TOKEN}"
      }
    },
    "argocd": {
      "command": "npx",
      "args": [
        "argocd-mcp@0.9.0",
        "stdio"
      ],
      "env": {
        "ARGOCD_BASE_URL": "${ARGOCD_BASE_URL}",
        "ARGOCD_API_TOKEN": "${ARGOCD_API_TOKEN}"
      }
    },
    "zammad": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/basher83/zammad-mcp.git@cf51c36f0aeb8d4313fdfa06eb49586a55592852",
        "mcp-zammad"
      ],
      "env": {
        "ZAMMAD_URL": "${ZAMMAD_URL}",
        "ZAMMAD_HTTP_TOKEN": "${ZAMMAD_HTTP_TOKEN}"
      }
    },
    "tailscale": {
      "command": "npx",
      "args": [
        "-y",
        "--package=@hexsleeves/tailscale-mcp-server@1.3.4",
        "tailscale-mcp-server"
      ],
      "env": {
        "TAILSCALE_API_KEY": "${TAILSCALE_API_KEY}",
        "TAILSCALE_TAILNET": "${TAILSCALE_TAILNET}"
      }
    },
    "no-bs-inbox": {
      "type": "http",
      "url": "http://127.0.0.1:22330/mcp",
      "headers": {
        "Authorization": "Bearer ${NO_BS_INBOX_TOKEN}"
      }
    },
    "kubecost": {
      "command": "tsh",
      "args": [
        "mcp",
        "connect",
        "kubecost-mcp"
      ]
    },
    "cost-dashboard": {
      "command": "tsh",
      "args": [
        "mcp",
        "connect",
        "cost-dashboard"
      ]
    }
  }
}
