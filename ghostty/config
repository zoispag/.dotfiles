# Font
font-family = MesloLGS Nerd Font Mono
font-size = 15

# Colors
background = #1d1d26
foreground = #cbcbf0
cursor-color = #cbcbf0
cursor-text = #ffffff
selection-background = #ff3399
selection-foreground = #ffffff
bold-color = #ffffff
palette = 0=#1d1d26
palette = 1=#ff3399
palette = 2=#00d364
palette = 3=#ffcc66
palette = 4=#00cbff
palette = 5=#cc66ff
palette = 6=#00ceca
palette = 7=#cbcbf0
palette = 8=#636667
palette = 9=#ff2f92
palette = 10=#00d364
palette = 11=#ffd479
palette = 12=#00cbff
palette = 13=#d783ff
palette = 14=#00d5d4
palette = 15=#d5d6f3

# Window
background-opacity = 0.95
background-blur = 8
window-width = 100
window-height = 30
window-padding-x = 6
window-padding-y = 6

# Cursor
cursor-style = block
cursor-style-blink = false

# Terminal
scrollback-limit = 200000
copy-on-select = clipboard
mouse-hide-while-typing = true
clipboard-trim-trailing-spaces = true
shell-integration = detect
shell-integration-features = cursor,sudo,title
macos-titlebar-style = tabs

# Keybinds: Ghostty's defaults already match iTerm2 for tabs (Cmd+T,
# Cmd+Shift+[ ]), splits (Cmd+D / Cmd+Shift+D) and Cmd+Opt+arrows.
# Add custom ones as:  keybind = cmd+k=clear_screen
